<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://www.example.org/SEGUV3_XML"
           elementFormDefault="qualified">

  <!-- Gyökérelem -->
  <xs:element name="Sportverseny_adatbazis">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Sportolo" type="SportoloTipus" maxOccurs="unbounded"/>
        <xs:element name="Csapat" type="CsapatTipus" maxOccurs="unbounded"/>
        <xs:element name="Verseny" type="VersenyTipus" maxOccurs="unbounded"/>
        <xs:element name="Helyszin" type="HelyszinTipus" maxOccurs="unbounded"/>
        <xs:element name="Szovetseg" type="SzovetsegTipus" maxOccurs="unbounded"/>
        <xs:element name="Reszvetel" type="ReszvetelTipus" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

    <!-- ===== Kulcsok ===== -->
    <xs:key name="sportolo_kulcs">
      <xs:selector xpath="Sportolo"/>
      <xs:field xpath="@sportolo_id"/>
    </xs:key>

    <xs:key name="csapat_kulcs">
      <xs:selector xpath="Csapat"/>
      <xs:field xpath="@csapat_id"/>
    </xs:key>

    <xs:key name="verseny_kulcs">
      <xs:selector xpath="Verseny"/>
      <xs:field xpath="@verseny_id"/>
    </xs:key>

    <xs:key name="helyszin_kulcs">
      <xs:selector xpath="Helyszin"/>
      <xs:field xpath="@helyszin_id"/>
    </xs:key>

    <xs:key name="szovetseg_kulcs">
      <xs:selector xpath="Szovetseg"/>
      <xs:field xpath="@szovetseg_id"/>
    </xs:key>

    <!-- ===== Idegen kulcsok ===== -->
    <xs:keyref name="csapat_ref_szovetseg" refer="szovetseg_kulcs">
      <xs:selector xpath="Csapat"/>
      <xs:field xpath="@sz_cs"/>
    </xs:keyref>

    <xs:keyref name="reszvetel_ref_csapat" refer="csapat_kulcs">
      <xs:selector xpath="Reszvetel"/>
      <xs:field xpath="@s_r_cs"/>
    </xs:keyref>

    <xs:keyref name="reszvetel_ref_verseny" refer="verseny_kulcs">
      <xs:selector xpath="Reszvetel"/>
      <xs:field xpath="@s_r_v"/>
    </xs:keyref>
    
    <xs:keyref name="sportolo_ref_csapat" refer="csapat_kulcs">
      <xs:selector xpath="Sportolo"/>
      <xs:field xpath="@cs_s"/>
    </xs:keyref>
    
    <xs:keyref name="verseny_ref_helyszin" refer="helyszin_kulcs">
      <xs:selector xpath="Verseny"/>
      <xs:field xpath="@v_h"/>
    </xs:keyref>
    
    <!-- Az 1:1 kapcsolat megvalósításához -->
    <xs:unique name="unique_helyszin">
      <xs:selector xpath="Helyszin"/>
      <xs:field xpath="@v_h"/>
    </xs:unique>
  </xs:element>

  <!-- ===== Sportoló ===== -->
  <xs:complexType name="SportoloTipus">
    <xs:sequence>
      <xs:element name="nev" type="NevTipus"/>
      <xs:element name="szuletesi_datum" type="xs:date"/>
      <xs:element name="elert_eredmenyek" type="EredmenyekTipus" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="sportolo_id" type="xs:string" use="required"/>
    <xs:attribute name="cs_s" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="EredmenyekTipus">
    <xs:sequence>
      <xs:element name="eredmeny" type="xs:string" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NevTipus">
    <xs:sequence>
      <xs:element name="vezeteknev" type="xs:string"/>
      <xs:element name="keresztnev" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Csapat ===== -->
  <xs:complexType name="CsapatTipus">
    <xs:sequence>
      <xs:element name="nev" type="xs:string"/>
      <xs:element name="sportag" type="xs:string"/>
      <xs:element name="edzo_nev" type="NevTipus"/>
      <xs:element name="orszag" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="csapat_id" type="xs:string" use="required"/>
    <xs:attribute name="sz_cs" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ===== Verseny ===== -->
  <xs:complexType name="VersenyTipus">
    <xs:sequence>
      <xs:element name="nev" type="xs:string"/>
      <xs:element name="datum" type="xs:date"/>
      <xs:element name="kategoria" type="xs:string"/>
      <xs:element name="szint" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="verseny_id" type="xs:string" use="required"/>
    <xs:attribute name="v_h" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ===== Helyszín ===== -->
  <xs:complexType name="HelyszinTipus">
    <xs:sequence>
      <xs:element name="varos" type="xs:string"/>
      <xs:element name="orszag" type="xs:string"/>
      <xs:element name="letesitmeny_nev" type="xs:string"/>
      <xs:element name="befogado_kepesseg" type="xs:integer"/>
    </xs:sequence>
    <xs:attribute name="helyszin_id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ===== Szövetség ===== -->
  <xs:complexType name="SzovetsegTipus">
    <xs:sequence>
      <xs:element name="nev" type="xs:string"/>
      <xs:element name="sportag" type="xs:string"/>
      <xs:element name="alapitasi_ev" type="xs:integer"/>
      <xs:element name="kozpont" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="szovetseg_id" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ===== Részvétel ===== -->
  <xs:complexType name="ReszvetelTipus">
    <xs:sequence>
      <xs:element name="helyezes" type="xs:integer"/>
      <xs:element name="pontszam" type="xs:integer"/>
      <xs:element name="dij_osszeg" type="xs:integer"/>
      <xs:element name="megjegyzes" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="s_r_cs" type="xs:string" use="required"/>
    <xs:attribute name="s_r_v" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
